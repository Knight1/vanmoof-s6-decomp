# motor_control — VanMoof S6 BLDC motor controller (reconstruction scaffold).
#
# PLACEHOLDER: motor_control is expected to be a TI C2000 (C28x) DSP, NOT an
# arm-none-eabi target (per the S5 equivalent, which was disassembled with IDA
# tms32028 and kept as reference C, not compiled). Do not assume the ARM compile
# gate applies here — settle the toolchain first (see docs/progress.md).

PROJECT := motor_control

.PHONY: all clean
all:
	@echo "$(PROJECT): TI C2000 target — no ARM build configured yet."
	@echo "See docs/progress.md (confirm C28x, pick disassembler/toolchain)."

clean:
	@rm -rf build
